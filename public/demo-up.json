  "generatedHtml": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\"/>\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"/>\n<title>Up · Series A pitch</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\"/>\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin/>\n<link href=\"https://fonts.googleapis.com/css2?family=Antonio:wght@600;700;800;900&family=DM+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap\" rel=\"stylesheet\"/>\n<style>\n*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}\nhtml,body{height:100%;overflow:hidden}\n:root{\n  --coral:#ff705c; --yellow:#ffee52; --black:#0d0d0d; --cream:#f5f0e8; --pink:#ff8bd1;\n  --bg:var(--coral); --surface:var(--black); --accent:var(--yellow); --fg:var(--cream);\n  --wire:rgba(255,255,255,0.12);\n  --fh:'Antonio',sans-serif; --fb:'DM Sans',sans-serif; --fm:'JetBrains Mono',monospace;\n  --ease:cubic-bezier(.16,1,.3,1); --ease-out:cubic-bezier(.76,0,.24,1);\n}\nbody{background:var(--bg);color:var(--fg);font-family:var(--fb);-webkit-font-smoothing:antialiased}\nbody::before{content:'';position:fixed;inset:0;z-index:9999;pointer-events:none;opacity:.28;mix-blend-mode:overlay;background-image:url(\"data:image/svg+xml,%3Csvg viewBox='0 0 512 512' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E\")}\n.cursor,.cursor-dot{position:fixed;top:0;left:0;pointer-events:none;z-index:9998;border-radius:50%;mix-blend-mode:difference;transition:width .22s,height .22s,background .22s;will-change:transform}\n.cursor{width:28px;height:28px;border:1.5px solid var(--yellow)}\n.cursor-dot{width:5px;height:5px;background:var(--yellow)}\n.cursor.hov{width:64px;height:64px;background:rgba(255,238,82,.14)}\n@media(hover:none),(max-width:900px){.cursor,.cursor-dot{display:none}}\n\n/* HUD */\n#hud{position:fixed;inset:0;pointer-events:none;z-index:1000}\n#bar{position:absolute;top:0;left:0;height:3px;background:var(--yellow);box-shadow:0 0 14px var(--yellow);transition:width .35s var(--ease);width:0}\n#hud-top{position:absolute;top:22px;left:28px;right:28px;display:flex;justify-content:space-between;align-items:center}\n.brand-mark{display:inline-flex;align-items:center;gap:10px;font-family:var(--fh);font-weight:900;font-size:18px;letter-spacing:-.02em;color:var(--cream);text-transform:lowercase}\n.brand-mark::before{content:'';width:22px;height:22px;border-radius:6px;background:var(--yellow);display:inline-block}\n#hud-counter{font-family:var(--fm);font-size:10px;letter-spacing:3px;text-transform:uppercase;color:var(--cream);opacity:.62}\n#hud-counter b{color:var(--yellow);font-weight:600;font-size:13px;margin-right:2px}\n#dot-nav{position:absolute;right:22px;top:50%;transform:translateY(-50%);display:flex;flex-direction:column;gap:10px;pointer-events:auto}\n#dot-nav button{width:6px;height:6px;border-radius:50%;border:none;background:rgba(245,240,232,.28);cursor:pointer;padding:0;transition:all .3s var(--ease)}\n#dot-nav button.active{background:var(--yellow);height:24px;border-radius:4px;box-shadow:0 0 12px var(--yellow)}\n#dot-nav button:hover{background:var(--cream)}\n#hud-label{position:absolute;bottom:24px;left:28px;font-family:var(--fm);font-size:10px;letter-spacing:3px;text-transform:uppercase;color:var(--cream);opacity:.5}\n#hud-label b{color:var(--yellow);font-weight:600}\n\n/* Deck + slide base */\n#deck{height:100vh;overflow-y:scroll;scroll-snap-type:y mandatory;scroll-behavior:smooth;-ms-overflow-style:none;scrollbar-width:none}\n#deck::-webkit-scrollbar{display:none}\n.slide{position:relative;min-height:100vh;width:100%;overflow:hidden;display:flex;flex-direction:column;justify-content:center;scroll-snap-align:start;scroll-snap-stop:always;perspective:1400px;padding:80px 56px 56px}\n.slide-inner{max-width:1240px;width:100%;margin:0 auto;position:relative;z-index:2;opacity:0;transform:translate3d(0,28px,0) scale(.985);filter:blur(6px);transition:opacity .9s var(--ease),transform .9s var(--ease),filter .9s var(--ease)}\n.slide.in-view .slide-inner{opacity:1;transform:none;filter:blur(0)}\n.slide.out-above .slide-inner{opacity:0;transform:translate3d(0,-5vh,0) scale(.97);filter:blur(5px);transition:all .75s var(--ease-out)}\n.slide.out-below .slide-inner{opacity:0;transform:translate3d(0,5vh,0) scale(.97);filter:blur(5px);transition:all .75s var(--ease-out)}\n\n.slide-num-bg{position:absolute;right:-.08em;bottom:-.18em;font-family:var(--fh);font-weight:900;font-size:clamp(220px,42vw,580px);line-height:1;letter-spacing:-.06em;color:rgba(0,0,0,.07);pointer-events:none;z-index:1;user-select:none;font-style:italic}\n.tag{display:inline-flex;align-items:center;gap:14px;font-family:var(--fm);font-size:11px;font-weight:500;color:var(--black);letter-spacing:3px;text-transform:uppercase;margin-bottom:28px;opacity:0;transform:translate3d(-20px,0,0);transition:opacity .7s .15s var(--ease),transform .7s .15s var(--ease)}\n.tag::before{content:'';width:32px;height:2px;background:var(--black);display:inline-block;transform:scaleX(0);transform-origin:left;transition:transform .8s .2s var(--ease)}\n.slide.in-view .tag{opacity:1;transform:none}\n.slide.in-view .tag::before{transform:scaleX(1)}\n.h1{font-family:var(--fh);font-weight:900;font-size:clamp(56px,8.5vw,128px);line-height:.88;letter-spacing:-.02em;text-transform:uppercase;color:var(--black);margin-bottom:24px;overflow:hidden}\n.h1 em{font-style:italic;color:var(--cream)}\n.h1 .accent{color:var(--cream);text-shadow:3px 3px 0 var(--black)}\n.h1 .reveal{display:inline-block;clip-path:inset(0 100% 0 0);transition:clip-path 1s .15s var(--ease)}\n.slide.in-view .h1 .reveal{clip-path:inset(0 0 0 0)}\n.sub{font-family:var(--fh);font-weight:800;font-size:clamp(22px,2.6vw,38px);line-height:1.1;letter-spacing:.5px;color:var(--black);text-transform:uppercase;margin-bottom:24px;max-width:880px;opacity:0;transform:translate3d(0,18px,0);transition:opacity .7s .35s var(--ease),transform .7s .35s var(--ease)}\n.slide.in-view .sub{opacity:1;transform:none}\n.lede{font-family:var(--fb);font-size:clamp(15px,1.3vw,18px);line-height:1.6;color:var(--black);max-width:780px;margin-bottom:28px;opacity:0;transform:translate3d(0,18px,0);transition:opacity .7s .5s var(--ease),transform .7s .5s var(--ease)}\n.slide.in-view .lede{opacity:1;transform:none}\n\n/* Stagger children entry */\n.stagger>*{opacity:0;transform:translate3d(0,32px,0) scale(.97);transition:opacity .7s var(--ease),transform .7s var(--ease);transition-delay:calc(var(--i,0)*90ms + 600ms)}\n.slide.in-view .stagger>*{opacity:1;transform:none}\n\n/* Per-child explode exit — cards scatter in 6 directions */\n.tx-group>*{transition:opacity .8s var(--ease-out),transform .9s var(--ease-out),filter .8s var(--ease-out);will-change:transform,opacity,filter}\n.slide.out-above .tx-group>*:nth-child(6n+1){opacity:0;transform:translate3d(-220%,-180%,620px) rotateZ(-50deg) rotateX(30deg) scale(.6);filter:blur(4px)}\n.slide.out-above .tx-group>*:nth-child(6n+2){opacity:0;transform:translate3d(230%,-220%,-480px) rotateZ(48deg) rotateY(-38deg) scale(.5);filter:blur(5px)}\n.slide.out-above .tx-group>*:nth-child(6n+3){opacity:0;transform:translate3d(-250%,210%,760px) rotateZ(60deg) rotateY(50deg) scale(.85);filter:blur(3px)}\n.slide.out-above .tx-group>*:nth-child(6n+4){opacity:0;transform:translate3d(260%,180%,-260px) rotateZ(-38deg) rotateX(-40deg) scale(.55);filter:blur(6px)}\n.slide.out-above .tx-group>*:nth-child(6n+5){opacity:0;transform:translate3d(-80%,-260%,500px) rotateZ(18deg) rotateY(78deg) scale(.4);filter:blur(4px)}\n.slide.out-above .tx-group>*:nth-child(6n+6){opacity:0;transform:translate3d(90%,240%,-420px) rotateZ(-70deg) rotateX(58deg) scale(.45);filter:blur(5px)}\n\n/* INTRO */\n#s-intro{padding:0;display:flex;align-items:center;justify-content:flex-start}\n#s-intro .slide-inner{max-width:none;padding:120px 7vw;display:flex;flex-direction:column;justify-content:center;min-height:100vh}\n.intro-mark{width:72px;height:72px;border-radius:18px;background:var(--yellow);margin-bottom:36px;display:flex;align-items:center;justify-content:center;font-family:var(--fh);font-weight:900;font-size:48px;color:var(--black);letter-spacing:-.04em;box-shadow:0 16px 60px rgba(0,0,0,.25)}\n.intro-mark::after{content:'up'}\n.intro-tag{font-family:var(--fm);font-size:11px;font-weight:500;color:var(--black);letter-spacing:5px;text-transform:uppercase;margin-bottom:30px}\n.intro-h{font-family:var(--fh);font-weight:900;font-size:clamp(72px,13vw,200px);line-height:.86;letter-spacing:-.03em;text-transform:uppercase;color:var(--black);margin-bottom:16px}\n.intro-h em{font-style:italic;color:var(--cream)}\n.intro-h .line2{display:block;color:var(--cream);text-shadow:4px 4px 0 var(--black)}\n.intro-divider{width:140px;height:3px;background:var(--black);margin:32px 0 24px;transform-origin:left;transform:scaleX(0);transition:transform 1s .5s var(--ease)}\n.slide.in-view .intro-divider{transform:scaleX(1)}\n.intro-meta{font-family:var(--fm);font-size:12px;color:var(--black);letter-spacing:1.5px;line-height:1.8;text-transform:uppercase}\n.intro-sig{margin-top:18px;display:flex;align-items:center;gap:14px}\n.intro-sig .name{font-family:var(--fh);font-weight:800;font-size:22px;color:var(--black);letter-spacing:.5px;text-transform:uppercase}\n.intro-sig .role{font-family:var(--fm);font-size:10px;color:var(--black);letter-spacing:2.5px;text-transform:uppercase;opacity:.7}\n.intro-sig .dot{width:6px;height:6px;background:var(--black);border-radius:50%}\n.scroll-cue{position:absolute;bottom:36px;left:50%;transform:translateX(-50%);font-family:var(--fm);font-size:10px;letter-spacing:3.5px;color:var(--black);text-transform:uppercase;display:flex;flex-direction:column;align-items:center;gap:14px;opacity:0;transition:opacity .8s 1.2s var(--ease)}\n.slide.in-view .scroll-cue{opacity:.7}\n.scroll-cue::after{content:'';width:1.5px;height:42px;background:linear-gradient(var(--black),transparent);animation:cue 1.8s ease-in-out infinite}\n@keyframes cue{0%,100%{transform:scaleY(.3);transform-origin:top}50%{transform:scaleY(1)}}\n\n/* PROBLEM (s3) — 3-card grid */\n.prob{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-top:36px}\n.prob-card{background:var(--surface);color:var(--cream);border-radius:22px;padding:30px 28px;position:relative;overflow:hidden;border:1px solid rgba(255,255,255,.06)}\n.prob-card::before{content:'';position:absolute;top:0;left:0;width:48px;height:3px;background:var(--yellow)}\n.prob-num{font-family:var(--fm);font-size:11px;color:var(--yellow);letter-spacing:3px;margin-bottom:20px}\n.prob-head{font-family:var(--fh);font-weight:800;font-size:24px;line-height:1.1;margin-bottom:16px;text-transform:uppercase;letter-spacing:.5px}\n.prob-body{font-size:13px;opacity:.72;line-height:1.6;margin-bottom:18px}\n.prob-foot{font-family:var(--fm);font-size:11px;color:var(--yellow);line-height:1.5;padding-top:16px;border-top:1px dashed rgba(255,255,255,.16)}\n@media(max-width:960px){.prob{grid-template-columns:1fr;gap:14px}}\n\n/* FIX (s5) — checks row */\n.fix-row{display:grid;grid-template-columns:repeat(5,1fr);gap:14px;margin-top:32px}\n.fix-check{background:var(--surface);color:var(--cream);border-radius:18px;padding:20px 18px;display:flex;flex-direction:column;gap:14px;font-size:13px;line-height:1.45;border:1px solid rgba(255,255,255,.05)}\n.fix-check::before{content:'✓';width:24px;height:24px;border-radius:8px;background:var(--yellow);color:var(--black);display:inline-flex;align-items:center;justify-content:center;font-weight:900;font-size:13px;font-family:var(--fh);box-shadow:0 4px 14px rgba(255,238,82,.4)}\n@media(max-width:960px){.fix-row{grid-template-columns:repeat(2,1fr)}}\n\n/* HOW (s6) — 4-step flow */\n.how-flow{display:grid;grid-template-columns:repeat(4,1fr);gap:18px;margin-top:32px;position:relative}\n.how-step{background:var(--surface);color:var(--cream);border-radius:22px;padding:30px 26px;position:relative;border:1px solid rgba(255,255,255,.06);overflow:hidden}\n.how-step::before{content:'';position:absolute;inset:0;background:linear-gradient(180deg,rgba(255,238,82,.06),transparent 40%);pointer-events:none}\n.how-num{font-family:var(--fh);font-weight:900;font-size:64px;color:var(--yellow);line-height:1;margin-bottom:14px;font-style:italic}\n.how-head{font-family:var(--fh);font-weight:800;font-size:18px;text-transform:uppercase;letter-spacing:.5px;margin-bottom:10px}\n.how-body{font-size:13px;opacity:.7;line-height:1.55}\n@media(max-width:960px){.how-flow{grid-template-columns:1fr 1fr;gap:14px}}\n\n/* VALIDATION (s7) — hero stats */\n.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:18px;margin-top:36px}\n.stat{background:var(--surface);color:var(--cream);border-radius:22px;padding:36px 28px;border:1px solid rgba(255,255,255,.06);position:relative;overflow:hidden}\n.stat::after{content:'';position:absolute;top:0;right:0;width:60px;height:60px;background:radial-gradient(circle at top right,rgba(255,238,82,.25),transparent 70%)}\n.stat-val{font-family:var(--fh);font-weight:900;font-size:clamp(44px,5vw,76px);line-height:1;color:var(--yellow);font-style:italic;letter-spacing:-.02em;margin-bottom:8px}\n.stat-lbl{font-family:var(--fm);font-size:11px;letter-spacing:2px;text-transform:uppercase;opacity:.55}\n@media(max-width:960px){.stats{grid-template-columns:1fr 1fr}}\n\n/* CUSTOMERS (s9) — bullets, but bigger */\n.cust-list{display:flex;flex-direction:column;gap:16px;margin-top:32px;max-width:840px}\n.cust-list li{list-style:none;background:var(--surface);color:var(--cream);border-radius:18px;padding:22px 28px;font-size:15px;line-height:1.5;display:flex;align-items:flex-start;gap:18px;border:1px solid rgba(255,255,255,.06)}\n.cust-list li::before{counter-increment:cust;content:counter(cust,decimal-leading-zero);font-family:var(--fh);font-weight:900;font-size:32px;color:var(--yellow);line-height:1;font-style:italic;flex-shrink:0;margin-top:-2px}\n.cust-list{counter-reset:cust}\n\n/* MARKET (s8) — stats with bigger viz */\n.market-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-top:32px}\n.market-grid .stat-val{font-size:clamp(36px,4.4vw,68px)}\n\n/* COMPETITION (s10) — matrix */\n.comp{display:grid;grid-template-columns:1.6fr repeat(3,1fr);gap:0;margin-top:32px;background:var(--surface);color:var(--cream);border-radius:22px;overflow:hidden;border:1px solid rgba(255,255,255,.06)}\n.comp>div{padding:18px 20px;border-bottom:1px solid rgba(255,255,255,.08);border-right:1px solid rgba(255,255,255,.08);font-size:13px}\n.comp>div:nth-child(4n){border-right:none}\n.comp .comp-head{background:#000;font-family:var(--fm);font-size:11px;text-transform:uppercase;letter-spacing:2.5px;color:var(--yellow);font-weight:600}\n.comp .row-lbl{font-weight:600;font-size:14px}\n.comp .y{color:var(--yellow);font-family:var(--fh);font-weight:900;font-size:22px;text-align:center;font-style:italic}\n.comp .n{opacity:.28;font-family:var(--fh);font-weight:900;font-size:22px;text-align:center}\n@media(max-width:960px){.comp{font-size:11px}.comp>div{padding:12px 10px}}\n\n/* ASK (s12) — split layout */\n.ask{display:grid;grid-template-columns:1.2fr 1fr;gap:32px;margin-top:32px}\n.ask-panel{background:var(--surface);color:var(--cream);border-radius:22px;padding:36px;border:1px solid rgba(255,255,255,.06)}\n.ask-panel h3{font-family:var(--fh);font-weight:800;font-size:18px;text-transform:uppercase;letter-spacing:.5px;color:var(--yellow);margin-bottom:18px}\n.ask-panel ul{list-style:none;display:flex;flex-direction:column;gap:14px}\n.ask-panel li{font-size:14px;line-height:1.5;padding-left:22px;position:relative}\n.ask-panel li::before{content:'';position:absolute;left:0;top:.7em;width:12px;height:2px;background:var(--yellow)}\n.ask-cta{background:var(--yellow);color:var(--black);padding:36px;border-radius:22px;display:flex;flex-direction:column;justify-content:space-between}\n.ask-cta .raise{font-family:var(--fh);font-weight:900;font-size:clamp(56px,7vw,96px);line-height:.9;letter-spacing:-.02em;font-style:italic}\n.ask-cta .raise small{font-style:normal;font-size:.35em;display:block;margin-top:8px;letter-spacing:3px;text-transform:uppercase}\n.ask-cta .contact{font-family:var(--fm);font-size:12px;letter-spacing:1.5px;margin-top:18px;line-height:1.6}\n.ask-cta a{color:var(--black);text-decoration:underline;font-weight:600}\n@media(max-width:960px){.ask{grid-template-columns:1fr}}\n\n/* MARQUEE bands */\n.marq{position:relative;min-height:100vh;background:var(--black);color:var(--cream);overflow:hidden;border-top:1px solid rgba(255,255,255,.06);border-bottom:1px solid rgba(255,255,255,.06);display:flex;flex-direction:column;justify-content:center;gap:24px;scroll-snap-align:start;scroll-snap-stop:always;padding:50px 0}\n.marq-row{display:flex;gap:80px;white-space:nowrap;animation:marq-l 48s linear infinite;will-change:transform}\n.marq-row.r{animation-name:marq-r;animation-duration:54s}\n.marq-row span{font-family:var(--fh);font-weight:900;font-style:italic;font-size:clamp(52px,9vw,140px);line-height:1;letter-spacing:-.02em;color:var(--yellow);text-transform:uppercase;display:inline-flex;align-items:center;gap:60px}\n.marq-row span::after{content:'';display:inline-block;width:12px;height:12px;border-radius:50%;background:var(--coral);box-shadow:0 0 20px var(--coral);flex-shrink:0}\n.marq-row.muted span{color:transparent;-webkit-text-stroke:1.5px var(--cream)}\n.marq-row.muted span::after{background:transparent;border:1.5px solid var(--cream);box-shadow:none}\n@keyframes marq-l{from{transform:translate3d(0,0,0)}to{transform:translate3d(-50%,0,0)}}\n@keyframes marq-r{from{transform:translate3d(-50%,0,0)}to{transform:translate3d(0,0,0)}}\n</style>\n</head>\n<body>\n<div class=\"cursor\"></div><div class=\"cursor-dot\"></div>\n<div id=\"hud\">\n  <div id=\"bar\"></div>\n  <div id=\"hud-top\">\n    <span class=\"brand-mark\">up</span>\n    <span id=\"hud-counter\"><b>01</b> / 11</span>\n  </div>\n  <nav id=\"dot-nav\"></nav>\n  <div id=\"hud-label\"></div>\n</div>\n<div id=\"deck\">\n\n<!-- INTRO -->\n<section class=\"slide\" id=\"s-intro\" data-idx=\"0\" data-label=\"intro\">\n  <div class=\"slide-inner\">\n    <div class=\"intro-mark\"></div>\n    <div class=\"intro-tag\">Series A · 2026</div>\n    <h1 class=\"intro-h\"><em>banking</em> <span class=\"line2\">for the</span> phone-first generation</h1>\n    <div class=\"intro-divider\"></div>\n    <div class=\"intro-meta\">700K+ customers · NPS 70+ · Built inside Bendigo's ADI licence</div>\n    <div class=\"intro-sig\">\n      <span class=\"name\">Dom Pym</span>\n      <span class=\"dot\"></span>\n      <span class=\"role\">Co-founder · Up</span>\n    </div>\n  </div>\n  <div class=\"scroll-cue\">scroll · or ↓</div>\n</section>\n\n<!-- PROBLEM -->\n<section class=\"slide\" id=\"s3\" data-idx=\"1\" data-label=\"problem\">\n  <span class=\"slide-num-bg\">01</span>\n  <div class=\"slide-inner\">\n    <div class=\"tag\">the problem</div>\n    <h2 class=\"h1\"><span class=\"reveal\">Banks built for a</span> <span class=\"reveal accent\">generation that left</span></h2>\n    <div class=\"sub\">Australia's big four ship apps that feel like PDFs you can tap.</div>\n    <p class=\"lede\">Of the 1.8M Australians 18-34 who opened a new account in 2024, 71% chose a neobank. The big four lost a generation in five years — and the apps are why.</p>\n    <div class=\"prob stagger tx-group\">\n      <div class=\"prob-card\" style=\"--i:0\">\n        <div class=\"prob-num\">01</div>\n        <div class=\"prob-head\">PDF-as-an-app</div>\n        <div class=\"prob-body\">CommBank takes 7 seconds to load, navigates like a 2010 website, hides pending transactions two taps deep.</div>\n        <div class=\"prob-foot\">→ baseline frustration</div>\n      </div>\n      <div class=\"prob-card\" style=\"--i:1\">\n        <div class=\"prob-num\">02</div>\n        <div class=\"prob-head\">Hidden tools</div>\n        <div class=\"prob-body\">Joint accounts, automated savings, instant categorisation exist in the big four. Nobody finds them. Nobody uses them.</div>\n        <div class=\"prob-foot\">→ unused power</div>\n      </div>\n      <div class=\"prob-card\" style=\"--i:2\">\n        <div class=\"prob-num\">03</div>\n        <div class=\"prob-head\">Generic everything</div>\n        <div class=\"prob-body\">Same product for an 18-year-old casual worker and a 60-year-old retiree. Nobody feels seen, nobody stays loyal.</div>\n        <div class=\"prob-foot\">→ no moat</div>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- MARQUEE 1 -->\n<section class=\"marq\" data-idx=\"2\" data-label=\"—\">\n  <div class=\"marq-row\"><span>they left the big four</span><span>they left the big four</span><span>they left the big four</span></div>\n  <div class=\"marq-row r muted\"><span>71% chose a neobank</span><span>71% chose a neobank</span><span>71% chose a neobank</span></div>\n</section>\n\n<!-- FIX -->\n<section class=\"slide\" id=\"s5\" data-idx=\"3\" data-label=\"fix\">\n  <span class=\"slide-num-bg\">02</span>\n  <div class=\"slide-inner\">\n    <div class=\"tag\">the fix</div>\n    <h2 class=\"h1\"><span class=\"reveal\">A real bank,</span> <span class=\"reveal accent\">built phone-first</span></h2>\n    <div class=\"sub\">ADI licence below. Modern infrastructure above. Built for one generation, deeply.</div>\n    <p class=\"lede\">Up is a real bank inside Bendigo's ADI licence — not a prepaid card, not a wallet, not a B2B layer. Phone-first design from the first commit.</p>\n    <div class=\"fix-row stagger tx-group\">\n      <div class=\"fix-check\" style=\"--i:0\">Push notification the second a transaction lands</div>\n      <div class=\"fix-check\" style=\"--i:1\">Named, nested savers — share \"Maybi\" with your partner</div>\n      <div class=\"fix-check\" style=\"--i:2\">Pay-day automation splits income before you can spend it</div>\n      <div class=\"fix-check\" style=\"--i:3\">Round-up rules with real customisation, not a toggle</div>\n      <div class=\"fix-check\" style=\"--i:4\">Spending insights that read like a friend, not a bank</div>\n    </div>\n  </div>\n</section>\n\n<!-- HOW -->\n<section class=\"slide\" id=\"s6\" data-idx=\"4\" data-label=\"how it works\">\n  <span class=\"slide-num-bg\">03</span>\n  <div class=\"slide-inner\">\n    <div class=\"tag\">how it works</div>\n    <h2 class=\"h1\"><span class=\"reveal\">Three layers,</span> <span class=\"reveal accent\">one experience</span></h2>\n    <div class=\"sub\">Bendigo licence at the floor. Up infrastructure in the middle. Native app on top.</div>\n    <p class=\"lede\">The architecture is the moat — most Aussie neobanks are prepaid wallets sitting on someone else's rails. Up runs its own ledger.</p>\n    <div class=\"how-flow stagger tx-group\">\n      <div class=\"how-step\" style=\"--i:0\">\n        <div class=\"how-num\">01</div>\n        <div class=\"how-head\">ADI licence</div>\n        <div class=\"how-body\">Bendigo & Adelaide Bank is the licensed entity. Full deposit guarantee. Zero regulatory ambiguity.</div>\n      </div>\n      <div class=\"how-step\" style=\"--i:1\">\n        <div class=\"how-num\">02</div>\n        <div class=\"how-head\">Up platform</div>\n        <div class=\"how-body\">Up-built ledger, payments engine, KYC. Modern stack ships features in weeks, not quarters.</div>\n      </div>\n      <div class=\"how-step\" style=\"--i:2\">\n        <div class=\"how-num\">03</div>\n        <div class=\"how-head\">Native app</div>\n        <div class=\"how-body\">iOS + Android first-class. No web compromises. New features land on phones first.</div>\n      </div>\n      <div class=\"how-step\" style=\"--i:3\">\n        <div class=\"how-num\">04</div>\n        <div class=\"how-head\">Community ops</div>\n        <div class=\"how-body\">In-app support thread, weekly product changelog, public roadmap. Users feel the build.</div>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- VALIDATION -->\n<section class=\"slide\" id=\"s7\" data-idx=\"5\" data-label=\"validation\">\n  <span class=\"slide-num-bg\">04</span>\n  <div class=\"slide-inner\">\n    <div class=\"tag\">validation</div>\n    <h2 class=\"h1\"><span class=\"reveal\">700K customers.</span> <span class=\"reveal accent\">Zero paid spend.</span></h2>\n    <div class=\"sub\">NPS in the 70s. Bank category average is 10.</div>\n    <p class=\"lede\">Up grew from 0 to 700,000+ customers in 5 years entirely through word of mouth. The community IS the growth engine.</p>\n    <div class=\"stats stagger tx-group\">\n      <div class=\"stat\" style=\"--i:0\"><div class=\"stat-val\">700K+</div><div class=\"stat-lbl\">customers in 5 yrs</div></div>\n      <div class=\"stat\" style=\"--i:1\"><div class=\"stat-val\">70+</div><div class=\"stat-lbl\">NPS · cat avg 10</div></div>\n      <div class=\"stat\" style=\"--i:2\"><div class=\"stat-val\">100K</div><div class=\"stat-lbl\">Maybi accounts 6mo</div></div>\n      <div class=\"stat\" style=\"--i:3\"><div class=\"stat-val\">$0</div><div class=\"stat-lbl\">paid acq, year 1</div></div>\n    </div>\n  </div>\n</section>\n\n<!-- CUSTOMERS -->\n<section class=\"slide\" id=\"s9\" data-idx=\"6\" data-label=\"customers\">\n  <span class=\"slide-num-bg\">05</span>\n  <div class=\"slide-inner\">\n    <div class=\"tag\">customers</div>\n    <h2 class=\"h1\"><span class=\"reveal\">Three named segments.</span> <span class=\"reveal accent\">All underserved.</span></h2>\n    <div class=\"sub\">Aussies 18-34 who want their bank to feel like a product, not a utility.</div>\n    <p class=\"lede\">We don't pitch \"everyone\" — we built for three sharp archetypes who all hated the same things about the big four.</p>\n    <ul class=\"cust-list stagger tx-group\">\n      <li style=\"--i:0\">Early-career professionals (24-30) — salary in, automated savings out, rent split with a partner.</li>\n      <li style=\"--i:1\">Freelancers + contractors (26-38) — variable income, tax-aware automation, business + personal in one app.</li>\n      <li style=\"--i:2\">Couples managing shared goals (25-40) — Maybi accounts, joint savers, transparent spending without resentment.</li>\n    </ul>\n  </div>\n</section>\n\n<!-- MARQUEE 2 -->\n<section class=\"marq\" data-idx=\"7\" data-label=\"—\">\n  <div class=\"marq-row\"><span>built phone-first</span><span>built phone-first</span><span>built phone-first</span></div>\n  <div class=\"marq-row r muted\"><span>community over budget</span><span>community over budget</span><span>community over budget</span></div>\n</section>\n\n<!-- MARKET -->\n<section class=\"slide\" id=\"s8\" data-idx=\"8\" data-label=\"market\">\n  <span class=\"slide-num-bg\">06</span>\n  <div class=\"slide-inner\">\n    <div class=\"tag\">market</div>\n    <h2 class=\"h1\"><span class=\"reveal\">$240B</span> <span class=\"reveal accent\">in motion</span></h2>\n    <div class=\"sub\">Aussie personal deposits. Neobanks at 4% today, forecast 18% by 2030.</div>\n    <p class=\"lede\">Australia has $240B in personal banking deposits across 8M 18-34 year-olds. The wedge isn't a future market — it's the share already shifting every quarter.</p>\n    <div class=\"market-grid stats stagger tx-group\">\n      <div class=\"stat\" style=\"--i:0\"><div class=\"stat-val\">$240B</div><div class=\"stat-lbl\">personal deposits AUS</div></div>\n      <div class=\"stat\" style=\"--i:1\"><div class=\"stat-val\">8M</div><div class=\"stat-lbl\">18-34 banking pop</div></div>\n      <div class=\"stat\" style=\"--i:2\"><div class=\"stat-val\">4→18%</div><div class=\"stat-lbl\">neobank share 2024-30</div></div>\n      <div class=\"stat\" style=\"--i:3\"><div class=\"stat-val\">9×</div><div class=\"stat-lbl\">5yr deposit growth</div></div>\n    </div>\n  </div>\n</section>\n\n<!-- COMPETITION -->\n<section class=\"slide\" id=\"s10\" data-idx=\"9\" data-label=\"competition\">\n  <span class=\"slide-num-bg\">07</span>\n  <div class=\"slide-inner\">\n    <div class=\"tag\">competition</div>\n    <h2 class=\"h1\"><span class=\"reveal\">Bank</span> <span class=\"reveal accent\">vs wallet</span></h2>\n    <div class=\"sub\">Most Aussie neobanks are prepaid cards. Up is a real bank.</div>\n    <div class=\"comp tx-group\">\n      <div class=\"comp-head row-lbl\">Capability</div>\n      <div class=\"comp-head\">Up</div>\n      <div class=\"comp-head\">Revolut AU</div>\n      <div class=\"comp-head\">Big-4 app</div>\n      <div class=\"row-lbl\">Full ADI deposit protection</div><div class=\"y\">✓</div><div class=\"n\">×</div><div class=\"y\">✓</div>\n      <div class=\"row-lbl\">Native phone-first design</div><div class=\"y\">✓</div><div class=\"y\">✓</div><div class=\"n\">×</div>\n      <div class=\"row-lbl\">Salary-day automation</div><div class=\"y\">✓</div><div class=\"n\">×</div><div class=\"n\">×</div>\n      <div class=\"row-lbl\">Shared accounts (joint savers)</div><div class=\"y\">✓</div><div class=\"n\">×</div><div class=\"y\">✓</div>\n      <div class=\"row-lbl\">Ships features in weeks</div><div class=\"y\">✓</div><div class=\"y\">✓</div><div class=\"n\">×</div>\n      <div class=\"row-lbl\">Community + transparent roadmap</div><div class=\"y\">✓</div><div class=\"n\">×</div><div class=\"n\">×</div>\n    </div>\n  </div>\n</section>\n\n<!-- ASK -->\n<section class=\"slide\" id=\"s12\" data-idx=\"10\" data-label=\"team & ask\">\n  <span class=\"slide-num-bg\">08</span>\n  <div class=\"slide-inner\">\n    <div class=\"tag\">team &amp; ask</div>\n    <h2 class=\"h1\"><span class=\"reveal\">The wedge is built.</span> <span class=\"reveal accent\">Now scale.</span></h2>\n    <div class=\"sub\">12-person team inside Bendigo. Hiring 25. Goal: 1.5M customers by EoY 2027.</div>\n    <div class=\"ask\">\n      <div class=\"ask-panel\">\n        <h3>Use of funds</h3>\n        <ul>\n          <li>60% engineering — lending + business banking ship in 18 months</li>\n          <li>25% community + brand — defend the moat that got us here</li>\n          <li>15% compliance scaling — Bendigo regulatory cadence at 1.5M</li>\n          <li>Hiring 25 across engineering + community ops</li>\n        </ul>\n      </div>\n      <div class=\"ask-cta\">\n        <div class=\"raise\">$40M<small>Series A · open now</small></div>\n        <div class=\"contact\">\n          Lead investor secured · 60% committed<br/>\n          Round terms on cap table<br/>\n          <a href=\"mailto:founders@up.com.au\">founders@up.com.au</a>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n\n</div>\n<script>\n(function(){\n  var deck=document.getElementById('deck');\n  var slides=Array.from(document.querySelectorAll('.slide,.marq'));\n  var total=slides.length;\n  // Build dots\n  var nav=document.getElementById('dot-nav');\n  slides.forEach(function(s,i){ var b=document.createElement('button'); b.dataset.idx=i; b.dataset.label=s.dataset.label||''; b.addEventListener('click',function(){slides[i].scrollIntoView({behavior:'smooth'})}); nav.appendChild(b); });\n  var dots=Array.from(nav.children);\n  var counter=document.getElementById('hud-counter');\n  var bar=document.getElementById('bar');\n  var lbl=document.getElementById('hud-label');\n  var current=0;\n  var obs=new IntersectionObserver(function(entries){\n    entries.forEach(function(e){\n      var sl=e.target;var idx=parseInt(sl.dataset.idx||'0',10);\n      if(e.isIntersecting){\n        sl.classList.add('in-view');sl.classList.remove('out-above','out-below');\n        current=idx;\n        dots.forEach(function(d,i){d.classList.toggle('active',i===idx)});\n        if(counter)counter.innerHTML='<b>'+('0'+(idx+1)).slice(-2)+'</b> / '+('0'+total).slice(-2);\n        if(bar)bar.style.width=((idx+1)/total*100)+'%';\n        if(lbl)lbl.innerHTML='<b>'+(sl.dataset.label||'')+'</b>';\n      } else {\n        sl.classList.remove('in-view');\n        var r=e.boundingClientRect;\n        if(r.top<0){sl.classList.add('out-above');sl.classList.remove('out-below')} else {sl.classList.add('out-below');sl.classList.remove('out-above')}\n      }\n    });\n  },{threshold:.5,root:deck});\n  slides.forEach(function(s){obs.observe(s)});\n  function go(i){if(i<0||i>=total)return;slides[i].scrollIntoView({behavior:'smooth'})}\n  document.addEventListener('keydown',function(e){\n    if(e.key==='ArrowDown'||e.key==='PageDown'){e.preventDefault();go(current+1)}\n    if(e.key==='ArrowUp'||e.key==='PageUp'){e.preventDefault();go(current-1)}\n    if(e.key==='Home'){e.preventDefault();go(0)}\n    if(e.key==='End'){e.preventDefault();go(total-1)}\n  });\n  var tsy=0;\n  deck.addEventListener('touchstart',function(e){tsy=e.touches[0].clientY},{passive:true});\n  deck.addEventListener('touchend',function(e){var dy=tsy-e.changedTouches[0].clientY;if(Math.abs(dy)>50)go(dy>0?current+1:current-1)});\n  // Custom cursor (desktop)\n  if(window.matchMedia&&window.matchMedia('(hover:hover)').matches&&window.matchMedia('(min-width:901px)').matches){\n    var cur=document.querySelector('.cursor');var dot=document.querySelector('.cursor-dot');\n    var mx=0,my=0,cx=0,cy=0;\n    document.addEventListener('mousemove',function(e){mx=e.clientX;my=e.clientY;dot.style.transform='translate('+mx+'px,'+my+'px) translate(-50%,-50%)'},{passive:true});\n    (function tick(){cx+=(mx-cx)*.2;cy+=(my-cy)*.2;cur.style.transform='translate('+cx+'px,'+cy+'px) translate(-50%,-50%)';requestAnimationFrame(tick)})();\n    document.querySelectorAll('a,button,[role=button]').forEach(function(el){el.addEventListener('mouseenter',function(){cur.classList.add('hov')});el.addEventListener('mouseleave',function(){cur.classList.remove('hov')})});\n  }\n  // Initialise\n  slides[0].classList.add('in-view');\n  dots[0].classList.add('active');\n})();\n</script>\n</body>\n</html>",
